# Create one Telegram bot with @BotFather and keep its token only in Render.
TELEGRAM_BOT_TOKEN="123456:replace-me"

# Firebase service-account JSON, as a single-line JSON string.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account"}'
FIRESTORE_DATABASE_ID=ai-studio-mmvsubs-7f61226f-682f-4402-823f-82cb55675031
AUTO_ENABLE_FIRESTORE_API=true

# The bot uses Uzbekistan time for reminders unless changed.
TIME_ZONE="Asia/Tashkent"
